# === Storage & Database ===
# Paths disimpan di app/config.py, tapi bisa override di sini kalau perlu
# DATABASE_URL=sqlite:///./storage/app.db

# === Whisper Model ===
# tiny (39M), base (140M), small (244M), medium (769M), large (2.9GB)
# Trade-off: lebih kecil = lebih cepat, lebih besar = lebih akurat
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=auto  # deteksi CUDA yang benar-benar tersedia, selain itu CPU
# Beam lebih rendah + VAD membuat job CPU berdurasi panjang lebih cepat.
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_CPU_THREADS=0
CPU_TRANSCRIPTION_RTF=1.75
GPU_TRANSCRIPTION_RTF=0.35

# === Highlight Detection Thresholds ===
HIGHLIGHT_WINDOW_SECONDS=5.0
HIGHLIGHT_MIN_CLIP_SECONDS=10.0
HIGHLIGHT_MAX_CLIP_SECONDS=60.0
# 0 = jumlah kandidat adaptif dari durasi sumber (bukan selalu lima).
HIGHLIGHT_TOP_N=0

# === Ollama (Metadata Generation) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b  # sesuaikan dengan output `ollama list`
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_PREDICT=220
METADATA_DEFAULT_LANGUAGE=id  # id atau en

# === YouTube Download ===
# Waktu maksimum untuk unduhan video YouTube di worker.
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=900
# Jumlah fragmen YouTube yang diunduh paralel. Mulai dari 4; naikkan bertahap
# hanya bila server tidak terkena throttling dari YouTube.
YOUTUBE_DOWNLOAD_CONCURRENT_FRAGMENTS=4
# Batas tinggi video sumber untuk menekan waktu transfer. Gunakan 0 untuk
# kualitas terbaik yang tersedia dari yt-dlp.
YOUTUBE_DOWNLOAD_MAX_HEIGHT=720
# Opsional bila YouTube tetap menolak download: path cookies.txt format
# Netscape dari browser pada jaringan yang sama. Jangan simpan ke git.
# YOUTUBE_COOKIES_PATH=/app/storage/secrets/youtube-cookies.txt
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...

# === Social Render ===
# auto mencoba GPU NVIDIA (NVENC) bila tersedia, lalu otomatis fallback ke CPU.
RENDER_ACCELERATION=auto
WATERMARK_ENABLED=true
WATERMARK_TEXT=@RidhoWahyu
WATERMARK_OPACITY=0.78
WATERMARK_POSITION=bottom_right

# === Upload Limits ===
MAX_UPLOAD_SIZE_MB=2048

# === Operations ===
LOG_LEVEL=INFO
LOG_ROTATION=50 MB
LOG_RETENTION_DAYS=7
TEMP_CLEANUP_ENABLED=true
TEMP_CLEANUP_INTERVAL_HOURS=6
TEMP_FILE_RETENTION_HOURS=24
TRANSCRIPTION_TIMEOUT_MIN_SECONDS=900
TRANSCRIPTION_TIMEOUT_MULTIPLIER=4.0
TRANSCRIPTION_TIMEOUT_MAX_SECONDS=14400
# Hanya cadence laporan; render/transkripsi CPU bisa sah melapor tiap 30–60 dtk.
JOB_HEARTBEAT_INTERVAL_SECONDS=30
