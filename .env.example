# Browser-facing API URL. This value is baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Change when port 3000 is already used by a local Next.js server.
FRONTEND_HOST_PORT=3000

# Backend processing defaults
APP_VERSION=1.0.0
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=auto
# Auto only enables CUDA after CTranslate2 can see it inside the container.
# AMD/DirectML is not a CUDA/NVENC path and will remain on CPU automatically.
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
# 0 lets CTranslate2 use the CPU count available to Docker. Benchmark 2/4 only
# when a real source video shows an improvement.
WHISPER_CPU_THREADS=0
CPU_TRANSCRIPTION_RTF=1.75
GPU_TRANSCRIPTION_RTF=0.35
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_PREDICT=220
MAX_UPLOAD_SIZE_MB=2048
METADATA_DEFAULT_LANGUAGE=id
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=900
# Number of simultaneous YouTube video/audio fragments. Start with 4; increase
# gradually only when the server is not being throttled by YouTube.
YOUTUBE_DOWNLOAD_CONCURRENT_FRAGMENTS=4
# Cap source quality to reduce transfer time. Use 0 for yt-dlp best available.
YOUTUBE_DOWNLOAD_MAX_HEIGHT=720
# Optional: path inside the backend container to a fresh Netscape cookies.txt
# exported from the same network/browser. Do not commit this file.
# YOUTUBE_COOKIES_PATH=/app/storage/secrets/youtube-cookies.txt
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
# Always automatic: use NVIDIA NVENC only after an actual one-frame runtime
# probe succeeds; otherwise render on CPU with no failed GPU retry per clip.
RENDER_ACCELERATION=auto
WATERMARK_ENABLED=true
WATERMARK_TEXT=@RidhoWahyu
WATERMARK_OPACITY=0.78
WATERMARK_POSITION=bottom_right
TEMP_CLEANUP_ENABLED=true
TEMP_CLEANUP_INTERVAL_HOURS=6
TEMP_FILE_RETENTION_HOURS=24
UPLOAD_RETENTION_DAYS=0
CLIP_RETENTION_DAYS=0
REQUEUE_PENDING_JOBS_ON_STARTUP=true
# Job aktif yang terputus saat restart ditandai gagal; gunakan Retry dari UI bila diperlukan.
TRANSCRIPTION_TIMEOUT_MIN_SECONDS=900
TRANSCRIPTION_TIMEOUT_MULTIPLIER=4.0
TRANSCRIPTION_TIMEOUT_MAX_SECONDS=14400
# Reporting cadence, not a timeout: 30–60 seconds can be normal on CPU.
JOB_HEARTBEAT_INTERVAL_SECONDS=30
LOG_JSON=false

# Optional local multi-user workspace. Keep false for personal/offline use.
AUTH_ENABLED=false
AUTH_TOKEN_TTL_HOURS=168
# Generate a long random value before setting AUTH_ENABLED=true.
AUTH_SECRET_KEY=change-this-before-enabling-auth

# Optional Ollama container host port. The backend still needs OLLAMA_BASE_URL=http://ollama:11434.
OLLAMA_HOST_PORT=11435
